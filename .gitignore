# Live guild state is per-machine and mutable: task statuses flip on every
# dispatch, verdicts are transient, and two sessions running at once would
# collide here. Archived runs are the opposite, immutable history worth
# carrying, so they travel while the working state stays local.
.agent-guild/state/*
!.agent-guild/state/archive/

# check-a11y self-bootstraps these on first run; they're heavy and host-specific.
.agent-guild/scripts/node_modules/
.agent-guild/scripts/package-lock.json

# The audition log is the one piece of state we DO track—it accumulates across jobs.
!.claude/skills/audition/results/results.jsonl

__pycache__/
*.pyc

.DS_Store

# Host packages staged for release. Published trees are generated, never authored.
/dist/

# Local-only active context (working-memory-kit)
_working-memory/activeContext.md

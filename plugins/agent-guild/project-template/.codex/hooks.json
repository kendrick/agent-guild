{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guild/hooks/codex-hook-adapter.py\" session-nudge",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guild/hooks/codex-hook-adapter.py\" dispatch-guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guild/hooks/codex-hook-adapter.py\" orchestrator-write-guard",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "auditor|checker-courier|checker-deterministic|checker-judgment|hydrator|worker-bulk|worker-craft|worker-standard|working-memory-synchronizer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guild/hooks/codex-hook-adapter.py\" subagent-return",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guild/hooks/codex-hook-adapter.py\" stop-gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
